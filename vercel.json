{
  "rewrites": [
    {
      "source": "/share/:path*",
      "destination": "/api/share"
    },
    {
      "source": "/maths-share",
      "destination": "/api/maths-share"
    },
    {
      "source": "/custom-test-share",
      "destination": "/api/custom-test-share"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
